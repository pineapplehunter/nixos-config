# HOST ONLY: all environment values are non-secret. Authentication is file-only.
CALDAV_URL=https://dav.example.net/
CALDAV_CREDENTIALS_FILE=/absolute/path/to/sops-decrypted/radicale-agent-credentials
APP_TIMEZONE=Asia/Tokyo
# Keep false for the initial read smoke test; set true after verifying Agent.
CALDAV_WRITES_ENABLED=false
# The exact discovered existing collection URL; display name must be Agent.
CALDAV_AGENT_COLLECTION_URL=https://dav.example.net/user/discovered-id/
