Backport FFmpeg's SVT-AV1 4.x adaptive quantization field rename.

Upstream: https://github.com/FFmpeg/FFmpeg/commit/a5d4c398b411a00ac09d8fe3b66117222323844c

Keep adaptive quantization disabled for explicit QP rather than dropping the
assignment: SVT-AV1 4.x renamed enable_adaptive_quantization to aq_mode.
Remove this patch once the Raspberry Pi FFmpeg fork includes the upstream fix.

diff --git a/libavcodec/libsvtav1.c b/libavcodec/libsvtav1.c
--- a/libavcodec/libsvtav1.c
+++ b/libavcodec/libsvtav1.c
@@ -238,7 +238,11 @@ static int config_enc_params(EbSvtAv1EncConfiguration *param,
     } else if (svt_enc->qp > 0) {
         param->qp                   = svt_enc->qp;
         param->rate_control_mode    = 0;
+#if SVT_AV1_CHECK_VERSION(4, 0, 0)
+        param->aq_mode = 0;
+#else
         param->enable_adaptive_quantization = 0;
+#endif
     }
 
     desc = av_pix_fmt_desc_get(avctx->pix_fmt);
